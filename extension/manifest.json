{
  "manifest_version": 3,
  "name": "FOC GH",
  "version": "0.5.0",
  "description": "Utilities for FOC team members working in GitHub.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "identity", "activeTab", "scripting"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "commands": {
    "copy-link-as-markdown": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Copy this page's title and URL as a rich-text link"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "FOC GH",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/issues/*",
        "https://github.com/*/*/pull/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/orgs/*/projects/*/views/*"
      ],
      "js": ["board-filter.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": ["native-picker.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.css",
        "pr-expand-main-world.js",
        "board-data-injector.js",
        "native-picker-injector.js"
      ],
      "matches": ["https://github.com/*"]
    }
  ]
}
